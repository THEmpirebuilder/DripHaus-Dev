# Supabase — projet "Driphaus Project" (eu-central-2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Commission plateforme, en points de base (250 = 2.5 %)
PLATFORM_FEE_BPS=250

# URL publique du site (liens de confirmation e-mail). Optionnel en dev.
NEXT_PUBLIC_SITE_URL=

# Studio IA — Vercel AI Gateway (routage "provider/model").
# Sur Vercel, OIDC peut suffire ; en local, définir la clé du gateway.
AI_GATEWAY_API_KEY=
